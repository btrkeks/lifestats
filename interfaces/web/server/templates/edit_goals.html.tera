{% extends "base" %}

{% block title %}Edit Statistic Goals{% endblock %}

{% block additional_styles %}
.card {
height: 100%;
transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:hover {
transform: translateY(-2px);
box-shadow: 0 4px 8px rgba(0,0,0,0.15) !important;
}

@media (prefers-color-scheme: dark) {
.card {
background-color: #2b3035;
color: #fff;
}
.form-control {
background-color: #1a1d20;
border-color: #373b3e;
color: #fff;
}
.form-control:focus {
background-color: #1a1d20;
color: #fff;
border-color: #0d6efd;
}
.form-control::placeholder {
color: #6c757d;
}
.text-muted {
color: #a0a6ab !important;
}
.btn-primary {
background-color: #0d6efd;
border-color: #0d6efd;
}
.btn-primary:hover {
background-color: #0b5ed7;
border-color: #0a58ca;
}
.form-text {
color: #a0a6ab !important;
}
.card-title, .form-label {
color: #fff;
}
.alert {
color: #fff;
border: none;
}
.alert-success {
background-color: #198754;
}
.alert-danger {
background-color: #dc3545;
}
.alert .btn-close {
filter: invert(1) grayscale(100%) brightness(200%);
}
}
{% endblock %}

{% block content %}
<div class="container">
    {% if flash %}
    <div class="alert alert-{{ flash.0 }} alert-dismissible fade show mb-4" role="alert">
        {{ flash.1 }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row row-cols-1 row-cols-md-2 g-4">
        {% for stat in statistics %}
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">{{ stat.name }}</h5>
                    <p class="card-text text-muted small mb-3">{{ stat.category }}</p>

                    <form action="/goals" method="POST" class="mt-3">
                        <input type="hidden" name="statistic_id" value="{{ stat.id }}">

                        <div class="mb-3">
                            <label class="form-label d-block">Current Goal:
                                <span class="text-muted">
                                    {% if stat.current_goal %}
                                        {{ stat.current_goal }}
                                    {% else %}
                                        No goal set
                                    {% endif %}
                                </span>
                            </label>

                            <div class="input-group">
                                <input type="text"
                                       class="form-control"
                                       name="goal_value"
                                       placeholder="Enter new goal"
                                       {% if stat.example_format %}
                                       title="Format: {{ stat.example_format }}"
                                       {% endif %}>

                                <button type="submit" class="btn btn-primary">Update</button>
                            </div>

                            {% if stat.example_format %}
                            <div class="form-text small">Format: {{ stat.example_format }}</div>
                            {% endif %}
                        </div>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}