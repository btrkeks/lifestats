[Unit]
Description=Daily Fitbit Data Sync Timer for LifeStats
Documentation=https://github.com/yourusername/lifestats
Requires=lifestats-fitbit-sync.service

[Timer]
OnCalendar=*-*-* 06:00:00
RandomizedDelaySec=0
AccuracySec=1s
# Run immediately if the system was off during the scheduled time
Persistent=true

[Install]
WantedBy=timers.target
