[Unit]
Description=LifeStats Fitbit Data Sync
Documentation=https://github.com/yourusername/lifestats
After=network-online.target lifestats-web-api.service
Wants=network-online.target
Requires=lifestats-web-api.service

[Service]
Type=oneshot
# Sync yesterday through today so finalized late data is backfilled and today's sleep is visible
ExecStart=/bin/bash -c 'YESTERDAY=$(date -d "yesterday" +%%Y-%%m-%%d); \
  TODAY=$(date +%%Y-%%m-%%d); \
  for i in {1..5}; do \
    curl -X POST http://localhost:3000/integrations/fitbit/sync \
      -H "Content-Type: application/json" \
      -d "{\\"since\\": \\"$YESTERDAY\\", \\"until\\": \\"$TODAY\\"}" \
      --fail --silent --show-error && break || \
      { echo "Attempt $i failed, waiting 10s..."; sleep 10; }; \
  done'

# Optional: Set the user if you want to run as a specific user
# User=your-username
# Group=your-group

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lifestats-fitbit-sync

# Restart policy for failures
# Restart=on-failure
# RestartSec=5m

[Install]
WantedBy=multi-user.target
