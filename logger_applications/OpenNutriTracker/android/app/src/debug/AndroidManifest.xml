<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.opennutritracker.ont.opennutritracker">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Engine probe (EngineProbeReceiver.kt). Exported so adb can reach
             it; DUMP is held by the shell and the system, not by apps. -->
        <receiver
            android:name="com.opennutritracker.ont.opennutritracker.EngineProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
