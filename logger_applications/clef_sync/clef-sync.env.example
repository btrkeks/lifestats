# SSH account that can run sudo -n -u clef on the Clef production host.
CLEF_SYNC_SSH_HOST=root@app.playclef.com

# Clef account whose activity is exported. The exporter normalizes case and whitespace.
CLEF_SYNC_ACCOUNT_EMAIL=you@example.com

# Existing Lifestats IntegerAmount statistic for whole practice minutes.
CLEF_SYNC_LIFESTATS_STATISTIC_ID=42

# Optional overrides. The UTC offset defaults to the local machine's current offset.
# CLEF_SYNC_DAYS=7
# CLEF_SYNC_UTC_OFFSET_MINUTES=120
# CLEF_SYNC_LIFESTATS_BASE_URL=http://localhost:3000
# User and system SSH config are ignored. Set this for a non-default key.
# CLEF_SYNC_SSH_IDENTITY_FILE=/home/you/.ssh/clef-activity
# CLEF_SYNC_REMOTE_SERVICE_USER=clef
# CLEF_SYNC_REMOTE_CLEF_PATH=/opt/clef/bin/clef
# CLEF_SYNC_REMOTE_DB_PATH=/var/lib/clef/memorization.sqlite
