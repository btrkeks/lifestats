<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Statistics{% endblock %}</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            padding-top: 70px;
        }

        /* Dark mode styles */
        @media (prefers-color-scheme: dark) {
            body {
                background-color: #212529;
            }
            .navbar {
                background-color: #2b3035 !important;
            }
            .nav-link {
                color: #fff !important;
            }
            .nav-link.active {
                color: #fff !important;
                background-color: #0d6efd !important;
            }
            .navbar-brand {
                color: #fff !important;
            }
        }

        .nav-link.active {
            background-color: #0d6efd;
            color: white;
            border-radius: 4px;
        }

        {% block additional_styles %}{% endblock %}
    </style>
</head>
<body>
<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light fixed-top">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Statistics</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link {% if active_page == 'plots' %}active{% endif %}"
                       href="/"
                       {% if active_page == 'plots' %}aria-current="page"{% endif %}>
                    Plots
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if active_page == 'logger' %}active{% endif %}"
                       href="/log"
                       {% if active_page == 'logger' %}aria-current="page"{% endif %}>
                    Logger
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if active_page == 'goals' %}active{% endif %}"
                       href="/goals"
                       {% if active_page == 'goals' %}aria-current="page"{% endif %}>
                    Goals
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

{% block content %}{% endblock %}

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
{% block additional_scripts %}{% endblock %}
</body>
</html>