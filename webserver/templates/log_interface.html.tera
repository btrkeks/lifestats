{% extends "base" %}

{% block title %}Statistics Logger{% endblock %}

{% block additional_styles %}
.form-container {
max-width: 800px;
margin: 0 auto;
}

.form-footer {
margin-top: 2rem;
padding-top: 1.5rem;
border-top: 1px solid #dee2e6;
text-align: right;
}

.btn-submit {
min-width: 120px;
}

@media (prefers-color-scheme: dark) {
.card {
background-color: #2b3035;
color: #fff;
}
.form-control, .form-select {
background-color: #1a1d20;
border-color: #373b3e;
color: #fff;
}
.form-control:focus, .form-select:focus {
background-color: #1a1d20;
color: #fff;
border-color: #0d6efd;
}
.form-text {
color: #a0a6ab !important;
}
.card-title, .form-label {
color: #fff;
}
.form-footer {
border-top-color: #373b3e;
}
.alert {
color: #fff;
border: none;
}
.alert-success {
background-color: #198754;
}
.alert-danger {
background-color: #dc3545;
}
.alert .btn-close {
filter: invert(1) grayscale(100%) brightness(200%);
}
}
{% endblock %}

{% block content %}
<div class="container">
    <div class="form-container">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title h4 mb-4">Log Statistic</h2>

                {% if flash %}
                <div class="alert alert-{{ flash.0 }} alert-dismissible fade show mb-4" role="alert">
                    {{ flash.1 }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                {% endif %}

                <form action="/log" method="POST">
                    <div class="mb-4">
                        <label for="statistic" class="form-label">Statistic</label>
                        <select class="form-select form-select-lg" id="statistic" name="statistic" required>
                            <option value="" selected disabled>Choose statistic...</option>
                            {% for stat in statistics %}
                            <option value="{{ stat.id }}">{{ stat.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="value" class="form-label">Value</label>
                        <input type="text" class="form-control form-control-lg" id="value" name="value" required>
                    </div>

                    <div class="mb-4">
                        <label for="update_policy" class="form-label">Update Policy</label>
                        <select class="form-select form-select-lg" id="update_policy" name="update_policy">
                            {% for policy in update_policies %}
                            <option value="{{ policy }}">{{ policy }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary btn-lg btn-submit">
                            Log Value
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}