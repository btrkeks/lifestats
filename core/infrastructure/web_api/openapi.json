{
  "components": {
    "schemas": {
      "BeurerDayRequest": {
        "additionalProperties": false,
        "properties": {
          "body_fat_permille": {
            "format": "int64",
            "maximum": 1000,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "body_water_permille": {
            "format": "int64",
            "maximum": 1000,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "muscle_permille": {
            "format": "int64",
            "maximum": 1000,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "weight_grams": {
            "format": "int64",
            "maximum": 500000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "weight_grams"
        ],
        "type": "object"
      },
      "EbookDayRequest": {
        "additionalProperties": false,
        "properties": {
          "last_position": {
            "format": "int64",
            "maximum": 9007199254740992,
            "minimum": 0,
            "type": "integer"
          },
          "length": {
            "format": "int64",
            "maximum": 9007199254740992,
            "minimum": 1,
            "type": "integer"
          },
          "observed_at": {
            "format": "date-time",
            "type": "string"
          },
          "spans": {
            "description": "Normalized half-open [start,end) pairs, 0 <= start < end <= length; sorted, disjoint and non-adjacent.",
            "items": {
              "items": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "maxItems": 4096,
            "type": "array"
          },
          "title": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "title",
          "length",
          "spans",
          "last_position",
          "observed_at"
        ],
        "type": "object"
      },
      "EbookDescriptor": {
        "properties": {
          "protocol": {
            "format": "int32",
            "maximum": 1,
            "minimum": 1,
            "type": "integer"
          },
          "server_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "server_id",
          "protocol"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "invalid_field",
          "unsupported_media_type",
          "malformed_json",
          "invalid_body",
          "projection_overflow",
          "bundle_conflict",
          "storage_error",
          "client_upgrade_required",
          "book_length_mismatch"
        ],
        "type": "string"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "OpenNutriTrackerDayRequest": {
        "additionalProperties": false,
        "description": "The app's complete day for both metrics. `[]` is a confirmed zero.",
        "properties": {
          "caffeine": {
            "items": {
              "$ref": "#/components/schemas/TimedMilligramsRequest"
            },
            "maxItems": 1000,
            "type": "array"
          },
          "nicotine": {
            "items": {
              "$ref": "#/components/schemas/TimedMilligramsRequest"
            },
            "maxItems": 1000,
            "type": "array"
          }
        },
        "required": [
          "caffeine",
          "nicotine"
        ],
        "type": "object"
      },
      "TimedMilligramsRequest": {
        "additionalProperties": false,
        "description": "One intake as the app recorded it.",
        "properties": {
          "amount_mg": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "time": {
            "description": "Exactly HH:MM:SS, the entry's local wall-clock time. `null` when the app knows\nthe day but not the time.",
            "example": "08:12:00",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "time",
          "amount_mg"
        ],
        "type": "object"
      },
      "YomikataDayRequest": {
        "additionalProperties": false,
        "properties": {
          "cards_reviewed": {
            "format": "int64",
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "study_time_seconds": {
            "description": "Exact engaged seconds. Existing study_minutes projects seconds / 60.",
            "format": "int64",
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "cards_reviewed",
          "study_time_seconds"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "",
    "license": {
      "name": ""
    },
    "title": "Lifestats integrations API",
    "version": "2"
  },
  "openapi": "3.1.0",
  "paths": {
    "/integrations/beurer/days/{day}": {
      "put": {
        "operationId": "replace_day",
        "parameters": [
          {
            "description": "Strict valid YYYY-MM-DD calendar date",
            "in": "path",
            "name": "day",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BeurerDayRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Daily readings and all four statistics committed"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed JSON or unreadable body"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Duplicate or wrongly typed tagged statistics"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unsupported media type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid date or field"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Storage failed without committing"
          }
        },
        "tags": [
          "super::beurer"
        ]
      }
    },
    "/integrations/ebook": {
      "get": {
        "operationId": "descriptor",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EbookDescriptor"
                }
              }
            },
            "description": "Persistent database identity and ebook protocol version"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Storage unavailable"
          }
        },
        "tags": [
          "ebook"
        ]
      },
      "post": {
        "operationId": "retired_provision",
        "responses": {
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Upgrade to the reading spans client"
          }
        },
        "tags": [
          "ebook"
        ]
      }
    },
    "/integrations/ebook/events": {
      "post": {
        "operationId": "retired_events",
        "responses": {
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Upgrade to the reading spans client"
          }
        },
        "tags": [
          "ebook"
        ]
      }
    },
    "/integrations/ebook/producers/{producer}/books/{book_key}/days/{day}": {
      "put": {
        "operationId": "put_day",
        "parameters": [
          {
            "description": "Canonical lowercase UUID of the reporting ttu origin",
            "in": "path",
            "name": "producer",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "ttu-text-v1: followed by 64 lowercase hex characters",
            "in": "path",
            "name": "book_key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Strict YYYY-MM-DD reading day (client local, 04:00 rollover), from 2026-10-01 to two days after the server local date",
            "in": "path",
            "name": "day",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EbookDayRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Merged (or already contained) and every projection committed"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed JSON or unreadable body"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bundle conflict or book length mismatch"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unsupported media type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid path or field, or aggregate overflow"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Storage failed without committing"
          }
        },
        "tags": [
          "ebook"
        ]
      }
    },
    "/integrations/opennutritracker/days/{day}": {
      "put": {
        "operationId": "replace_day",
        "parameters": [
          {
            "description": "Strict valid YYYY-MM-DD date the app counts the entries toward",
            "in": "path",
            "name": "day",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenNutriTrackerDayRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Both lists stored (or already identical); statistics created on first sync"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed JSON or unreadable body"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Duplicate, wrongly typed or non-mg tagged statistics"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unsupported media type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid date, field or daily total"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Storage failed without committing"
          }
        },
        "tags": [
          "super::opennutritracker"
        ]
      }
    },
    "/integrations/yomikata/days/{day}": {
      "put": {
        "operationId": "replace_day",
        "parameters": [
          {
            "description": "Strict valid YYYY-MM-DD calendar date",
            "in": "path",
            "name": "day",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/YomikataDayRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Daily totals and both projections committed"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed JSON or unreadable body"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Ambiguous or invalid legacy bundle"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unsupported media type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid date, field, or aggregate overflow"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Storage failed without committing"
          }
        },
        "tags": [
          "yomikata"
        ]
      }
    }
  }
}
